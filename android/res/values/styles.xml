<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TransparentActivity" parent="@android:style/Theme.Translucent.NoTitleBar"/>

    <style name="MyQtTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- Shown from the tap until Qt's first frame, so the wait looks
             like the app starting rather than a black screen. -->
        <item name="android:windowBackground">@drawable/splash</item>

        <!-- On Android 15 (SDK 35), edge-to-edge is enforced.
             Using EdgeToEdge.enable() in Activity.onCreate is the modern way to handle this.
             Deprecated statusBarColor and navigationBarColor items are removed
             to avoid Play Store warnings. -->
    </style>
</resources>
